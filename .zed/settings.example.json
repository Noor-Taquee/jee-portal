{
  "format_on_save": "off",
  "prettier": {
    "allowed": false
  },
  "lsp": {
    "json-language-server": {
      "settings": {
        "json": {
          "schemas": [
            {
              "fileMatch": ["*/.well-known/ai-catalog.json"],
              "url": "https://raw.githubusercontent.com/ards-project/ard-spec/main/spec/schemas/ai-catalog.schema.json"
            }
          ]
        }
      }
    },
    "oxfmt": {}
  },
  "languages": {
    "JSONC": {
      "prettier": {
        "allowed": false
      }
    },
    "JSON": {
      "prettier": {
        "allowed": false
      }
    },
    "HTML": {
      "prettier": {
        "allowed": false
      },
      "language_servers": ["!tailwindcss-language-server", "..."]
    },
    "TSX": {
      "prettier": {
        "allowed": false
      },
      "language_servers": ["!tailwindcss-language-server", "..."]
    },
    "CSS": {
      "language_servers": ["!tailwindcss-language-server", "..."]
    }
  },
  "file_types": {
    "Markdown": ["llms.txt"]
  }
}
