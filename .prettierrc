{
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 80,

  "trailingComma": "es5",
  "singleQuote": false,
  "jsxSingleQuote": false,

  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "singleAttributePerLine": true,

  "checkIgnorePragma": true,
  "requirePragma": false,

  "endOfLine": "lf"
}
